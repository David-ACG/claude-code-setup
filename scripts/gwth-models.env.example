# Copy to ~/.config/gwth-models.env and chmod 600. NEVER commit the real file.
#
#   install -m 600 /dev/null ~/.config/gwth-models.env
#   $EDITOR ~/.config/gwth-models.env
#
# Lane 1: GLM Coding Plan, used by `claude-alt glm` (Claude Code, per session)
ZAI_API_KEY=

# Lane 2: OpenRouter, used by Codex via the [model_providers.openrouter] block
# in ~/.codex/config.toml. Export it in your shell for Codex to see it.
OPENROUTER_API_KEY=
